# GEMINI_API_KEY: Optional for AI Studio runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted application URL.
APP_URL="http://localhost:3000"

# FlagShip Server Configuration
PORT=3000
FLAGSHIP_JWT_SECRET="replace-with-32-plus-char-random-secret-in-prod"
FLAGSHIP_DB_PATH="./flagship.db"

# PostgreSQL / Spring Boot Configuration (for Docker Compose & Maven)
SPRING_PROFILES_ACTIVE="docker"
POSTGRES_DB="flagship"
POSTGRES_USER="flagship"
POSTGRES_PASSWORD="change_me_in_production"
SPRING_DATASOURCE_URL="jdbc:postgresql://localhost:5432/flagship"
